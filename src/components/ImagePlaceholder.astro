---
interface Props {
  label?: string;
  alt?: string;
  orientation?: 'landscape' | 'portrait' | 'square' | 'wide';
  tone?: 'light' | 'dark' | 'clay' | 'olive' | 'rose' | 'tobacco';
  treatment?: 'default' | 'editorial';
  eager?: boolean;
}

const {
  label = 'Image pending',
  alt = 'Placeholder for project imagery to be supplied',
  orientation = 'landscape',
  tone = 'light',
  treatment = 'default',
  eager = false,
} = Astro.props;
const ratios = {
  landscape: 'aspect-[4/3]',
  portrait: 'aspect-[3/4]',
  square: 'aspect-square',
  wide: 'aspect-[16/8]',
};
const tones = {
  light: 'bg-paper-deep text-ink border-line',
  dark: 'bg-ink text-paper border-ink',
  clay: 'bg-clay text-paper border-clay-dark',
  olive: 'bg-olive text-paper border-olive',
  rose: 'bg-rose text-ink border-rose-dark',
  tobacco: 'bg-tobacco text-paper border-tobacco',
};
---

<div
  role="img"
  aria-label={alt}
  data-loading={eager ? 'eager' : 'lazy'}
  data-treatment={treatment}
  class:list={[
    'image-placeholder relative grid w-full place-items-center overflow-hidden border',
    ratios[orientation],
    tones[tone],
  ]}
>
  <div class="image-placeholder__inner absolute inset-4 border border-current opacity-20 md:inset-6"></div>
  <div class="image-placeholder__wash absolute inset-0 opacity-35 mix-blend-multiply" aria-hidden="true"></div>
  {treatment === 'default' && (
    <>
      <span class="eyebrow relative z-10 max-w-[18rem] px-8 text-center opacity-80">Visual direction pending · {label}</span>
      <span class="absolute bottom-5 left-5 text-[0.58rem] uppercase tracking-[0.12em] opacity-50">Content in progress</span>
    </>
  )}
</div>

<style>
  .image-placeholder {
    background-color: color-mix(in srgb, currentColor 8%, transparent);
  }

  .image-placeholder::before {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(115deg, transparent 0 45%, rgb(255 255 255 / 0.16) 45% 46%, transparent 46% 100%),
      radial-gradient(circle at 24% 18%, rgb(255 255 255 / 0.22), transparent 14rem),
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.08) 0 1px, transparent 1px 13px);
    content: "";
  }

  .image-placeholder::after {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(circle at 42% 28%, rgb(255 255 255 / 0.16) 0 1px, transparent 1px 3px),
      radial-gradient(circle at 64% 68%, rgb(28 27 25 / 0.12) 0 1px, transparent 1px 4px);
    opacity: 0.14;
    content: "";
  }

  .image-placeholder[data-treatment="editorial"] {
    border-color: rgb(28 27 25 / 0.18);
    color: rgb(247 240 228 / 0.9);
    background:
      linear-gradient(145deg, rgb(61 70 46 / 0.98), rgb(104 112 82 / 0.96) 46%, rgb(45 52 38 / 0.98)),
      var(--color-olive);
  }

  .image-placeholder[data-treatment="editorial"]::before {
    background:
      linear-gradient(114deg, transparent 0 38%, rgb(242 239 232 / 0.12) 38% 38.35%, transparent 38.35% 100%),
      linear-gradient(24deg, transparent 0 58%, rgb(28 27 25 / 0.16) 58% 58.4%, transparent 58.4% 100%),
      radial-gradient(ellipse at 28% 24%, rgb(242 239 232 / 0.22), transparent 15rem),
      radial-gradient(ellipse at 72% 76%, rgb(28 27 25 / 0.24), transparent 16rem),
      repeating-linear-gradient(90deg, rgb(242 239 232 / 0.055) 0 1px, transparent 1px 18px),
      repeating-linear-gradient(0deg, rgb(28 27 25 / 0.04) 0 1px, transparent 1px 16px);
  }

  .image-placeholder[data-treatment="editorial"]::after {
    background-image:
      radial-gradient(circle at 20% 18%, rgb(247 240 228 / 0.18) 0 0.75px, transparent 0.75px 3px),
      radial-gradient(circle at 72% 62%, rgb(28 27 25 / 0.2) 0 0.75px, transparent 0.75px 3.5px);
    opacity: 0.16;
    mix-blend-mode: soft-light;
  }

  .image-placeholder[data-treatment="editorial"] .image-placeholder__inner {
    inset: clamp(0.9rem, 2vw, 1.45rem);
    border-color: rgb(247 240 228 / 0.22);
    opacity: 1;
  }

  .image-placeholder[data-treatment="editorial"] .image-placeholder__inner::before,
  .image-placeholder[data-treatment="editorial"] .image-placeholder__inner::after {
    position: absolute;
    content: "";
  }

  .image-placeholder[data-treatment="editorial"] .image-placeholder__inner::before {
    inset: 9% 13% 18% 17%;
    border: 1px solid rgb(247 240 228 / 0.16);
  }

  .image-placeholder[data-treatment="editorial"] .image-placeholder__inner::after {
    inset: 54% 10% 12% 42%;
    border-top: 1px solid rgb(247 240 228 / 0.22);
    border-left: 1px solid rgb(247 240 228 / 0.14);
  }
</style>
