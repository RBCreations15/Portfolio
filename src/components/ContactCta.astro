---
import ButtonLink from './ButtonLink.astro';
import { withBase } from '../lib/paths';
---

<section class="bg-clay text-paper">
  <div class="site-container section-space grid gap-10 md:grid-cols-12 md:items-end">
    <div class="md:col-span-9">
      <p class="eyebrow mb-5 text-paper/65">Contact</p>
      <h2 class="m-0 max-w-[12ch] font-display text-[clamp(3.2rem,8vw,8rem)] font-normal leading-[0.9] tracking-[-0.055em]">
        Let’s build something people remember.
      </h2>
    </div>
    <div class="md:col-span-3 md:text-right">
      <ButtonLink href={withBase('/contact/')} variant="light">Get in touch</ButtonLink>
    </div>
  </div>
</section>
