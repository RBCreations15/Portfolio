---
import type { Service } from '../data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<article class="reveal grid gap-6 border-t border-line py-8 md:grid-cols-12 md:py-12">
  <p class="eyebrow m-0 text-clay md:col-span-1">{service.number}</p>
  <h2 class="m-0 font-display text-[clamp(2.3rem,5vw,5rem)] font-normal leading-[0.95] tracking-[-0.05em] md:col-span-4">
    {service.title}
  </h2>
  <div class="md:col-span-6 md:col-start-7">
    <p class="m-0 text-lg leading-relaxed text-muted">{service.description}</p>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      <div>
        <h3 class="eyebrow mb-3">Includes</h3>
        <ul class="m-0 list-none space-y-2 p-0 text-sm text-muted">
          {service.items.map((item) => <li class="border-t border-line pt-2">{item}</li>)}
        </ul>
      </div>
      <div>
        <h3 class="eyebrow mb-3">Note</h3>
        <p class="m-0 text-sm text-muted">Scope, timeline, and deliverables are shaped around the specific project after the needs are clear.</p>
      </div>
    </div>
  </div>
</article>
