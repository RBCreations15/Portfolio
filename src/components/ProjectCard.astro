---
import type { CollectionEntry } from 'astro:content';
import ImagePlaceholder from './ImagePlaceholder.astro';
import { withBase } from '../lib/paths';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
  large?: boolean;
}

const { project, index = 0, large = false } = Astro.props;
const { data } = project;
const tones = ['dark', 'clay', 'light'] as const;
const orientations = large ? ['wide', 'landscape'] as const : ['portrait', 'landscape', 'square'] as const;
const tone = tones[index % tones.length];
const orientation = orientations[index % orientations.length];
---

<article class="project-card group reveal" data-categories={data.categories.join(',')}>
  <a href={withBase(`/projects/${project.id}/`)} class="block no-underline">
    <div class="overflow-hidden">
      {
        data.heroImage ? (
          <img
            src={withBase(data.heroImage)}
            alt={data.heroAlt ?? ''}
            width="1600"
            height="1200"
            loading="lazy"
            class:list={['w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.015]', large ? 'aspect-[16/8]' : 'aspect-[4/3]']}
          />
        ) : (
          <div class="transition-transform duration-700 ease-out group-hover:scale-[1.01]">
            <ImagePlaceholder label={`${data.title} — hero image`} alt={`Placeholder for ${data.title} project hero image`} orientation={orientation} tone={tone} />
          </div>
        )
      }
    </div>
    <div class="grid grid-cols-[1fr_auto] gap-5 border-b border-line py-5">
      <div>
        <p class="eyebrow mb-2 text-muted">{data.categories.join(' · ')}</p>
        <h3 class="m-0 font-display text-[clamp(1.8rem,3vw,2.8rem)] font-normal leading-none tracking-[-0.04em]">{data.title}</h3>
        <p class="mt-3 max-w-xl text-sm text-muted">{data.summary}</p>
      </div>
      <div class="text-right">
        <p class="eyebrow m-0">{data.year}</p>
        <p class="mt-2 text-[0.62rem] uppercase tracking-[0.12em] text-clay">{data.status.replace('-', ' ')}</p>
      </div>
    </div>
  </a>
</article>
