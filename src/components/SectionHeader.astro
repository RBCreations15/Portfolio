---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="grid gap-8 border-t border-line pt-5 md:grid-cols-12 md:gap-6">
  <p class="eyebrow m-0 md:col-span-3">{eyebrow}</p>
  <div class="md:col-span-8 md:col-start-5">
    <h2 class="m-0 max-w-[13ch] font-display text-[clamp(2.8rem,6vw,6.5rem)] font-normal leading-[0.95] tracking-[-0.045em]">
      {title}
    </h2>
    {description && <p class="mt-6 max-w-2xl text-base text-muted md:text-lg">{description}</p>}
  </div>
</header>
