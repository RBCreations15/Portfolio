---
interface Props {
  href: string;
  variant?: 'solid' | 'outline' | 'light';
}

const { href, variant = 'solid' } = Astro.props;
---

<a
  href={href}
  data-variant={variant}
  class="button-link inline-flex min-h-12 items-center justify-center border px-6 py-3 text-[0.7rem] font-semibold uppercase tracking-[0.14em] no-underline transition-colors duration-300"
>
  <slot />
</a>

<style>
  .button-link[data-variant="solid"] {
    border-color: var(--color-ink);
    color: var(--color-paper);
    background: var(--color-ink);
  }

  .button-link[data-variant="solid"]:hover {
    border-color: var(--color-clay);
    background: var(--color-clay);
  }

  .button-link[data-variant="outline"] {
    border-color: var(--color-ink);
    color: var(--color-ink);
    background: transparent;
  }

  .button-link[data-variant="outline"]:hover {
    color: var(--color-paper);
    background: var(--color-ink);
  }

  .button-link[data-variant="light"] {
    border-color: var(--color-paper);
    color: var(--color-ink);
    background: var(--color-paper);
  }

  .button-link[data-variant="light"]:hover {
    color: var(--color-paper);
    background: transparent;
  }
</style>
