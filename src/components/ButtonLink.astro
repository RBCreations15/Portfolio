---
interface Props {
  href: string;
  variant?: 'solid' | 'outline' | 'light';
}

const { href, variant = 'solid' } = Astro.props;
---

<a
  href={href}
  data-variant={variant}
  class="button-link inline-flex min-h-12 items-center justify-center border px-7 py-3 text-[0.68rem] font-semibold uppercase tracking-[0.16em] no-underline"
>
  <slot />
</a>

<style>
  .button-link {
    border-width: 1px;
    line-height: 1;
    transition:
      color 260ms var(--ease-out),
      background-color 260ms var(--ease-out),
      border-color 260ms var(--ease-out),
      transform 260ms var(--ease-out);
  }

  .button-link:hover {
    transform: translateY(-1px);
  }

  .button-link[data-variant="solid"] {
    border-color: var(--color-ink);
    color: var(--color-paper);
    background: var(--color-ink);
  }

  .button-link[data-variant="solid"]:hover {
    border-color: var(--color-clay-dark);
    background: var(--color-clay-dark);
  }

  .button-link[data-variant="outline"] {
    border-color: var(--color-ink);
    color: var(--color-ink);
    background: transparent;
  }

  .button-link[data-variant="outline"]:hover {
    color: var(--color-paper);
    background: var(--color-ink);
  }

  .button-link[data-variant="light"] {
    border-color: var(--color-paper);
    color: var(--color-ink);
    background: var(--color-paper);
  }

  .button-link[data-variant="light"]:hover {
    color: var(--color-paper);
    background: transparent;
  }

  .button-link:focus-visible {
    outline: 2px solid var(--color-clay);
    outline-offset: 5px;
  }

  @media (prefers-reduced-motion: reduce) {
    .button-link:hover {
      transform: none;
    }
  }
</style>
