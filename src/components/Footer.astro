---
import { navigation, siteData } from '../data/site';
import { withBase } from '../lib/paths';

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-ink text-paper">
  <div class="site-container py-14 lg:py-20">
    <div class="grid gap-14 md:grid-cols-12">
      <div class="md:col-span-7">
        <p class="eyebrow mb-5 text-paper/60">Independent creative practice</p>
        <a href={withBase('/contact/')} class="inline-block max-w-[10ch] font-display text-[clamp(2.7rem,6vw,6rem)] leading-[0.92] tracking-[-0.05em] no-underline hover:text-paper/75">
          Let’s make something considered.
        </a>
      </div>
      <div class="grid grid-cols-2 gap-8 md:col-span-4 md:col-start-9">
        <div>
          <p class="eyebrow mb-5 text-paper/50">Navigate</p>
          <ul class="m-0 list-none space-y-2 p-0 text-sm">
            {navigation.map((item) => <li><a class="no-underline hover:text-paper/60" href={withBase(item.href)}>{item.label}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="eyebrow mb-5 text-paper/50">Connect</p>
          <p class="m-0 text-sm text-paper/70">{siteData.email}</p>
          <p class="mt-2 text-sm text-paper/70">{siteData.instagram}</p>
        </div>
      </div>
    </div>
    <div class="mt-20 flex flex-col gap-3 border-t border-paper/20 pt-5 text-[0.65rem] uppercase tracking-[0.12em] text-paper/50 sm:flex-row sm:justify-between">
      <p class="m-0">© {year} {siteData.name}. Content placeholders are marked.</p>
      <p class="m-0">Designed as a living creative archive.</p>
    </div>
  </div>
</footer>
