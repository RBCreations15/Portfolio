---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import { withBase } from '../../lib/paths';

export async function getStaticPaths() {
  const entries = (await getCollection('archive')).sort((a, b) => a.data.order - b.data.order);

  return entries.map((entry, index) => ({
    params: { id: entry.id },
    props: { entry, nextEntry: entries[(index + 1) % entries.length] },
  }));
}

interface Props {
  entry: CollectionEntry<'archive'>;
  nextEntry: CollectionEntry<'archive'>;
}

const { entry, nextEntry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
---

<BaseLayout title={data.title} description={data.summary}>
  <header class="site-container pb-12 pt-12 lg:pb-20 lg:pt-20">
    <a href={withBase('/archive/')} class="text-link mb-12">Back to Archive</a>
    <div class="grid gap-10 md:grid-cols-12 md:items-end">
      <div class="md:col-span-8">
        <p class="eyebrow mb-6 text-clay">{data.category} · {data.year}</p>
        <h1 class="page-title max-w-[14ch]">{data.title}</h1>
      </div>
      <p class="body-large m-0 text-muted md:col-span-4">{data.intro}</p>
    </div>
  </header>

  <section class="site-container pb-[var(--section-space)]" aria-label={`${data.title} gallery`}>
    <div class="grid gap-6 md:grid-cols-12">
      {data.gallery.map((item, index) => (
        <figure class:list={['reveal m-0', index % 3 === 0 ? 'md:col-span-12' : index % 3 === 1 ? 'md:col-span-5' : 'md:col-span-7 md:pt-20']}>
          <ImagePlaceholder label={item.label} alt={item.alt} orientation={item.orientation} tone={item.tone} />
          <figcaption class="mt-3 text-xs uppercase tracking-[0.12em] text-muted">Image placeholder · Content in progress</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="border-y border-line">
    <div class="site-container section-space grid gap-10 md:grid-cols-12">
      <p class="eyebrow m-0 text-clay md:col-span-3">Written note</p>
      <div class="md:col-span-7 md:col-start-5">
        {data.note && <p class="body-large m-0 text-muted">{data.note}</p>}
        <div class="mt-8 text-sm text-muted">
          <Content />
        </div>
      </div>
    </div>
  </section>

  <nav aria-label="Next archive entry" class="bg-tobacco text-paper">
    <a href={withBase(`/archive/${nextEntry.id}/`)} class="site-container group block py-16 no-underline lg:py-24">
      <p class="eyebrow mb-5 text-paper/60">Next entry</p>
      <div class="flex items-end justify-between gap-8">
        <span class="max-w-[12ch] font-display text-[clamp(3.2rem,8vw,8rem)] leading-[0.9] tracking-[-0.04em]">{nextEntry.data.title}</span>
        <span class="text-4xl transition-transform duration-300 group-hover:translate-x-2" aria-hidden="true">→</span>
      </div>
    </a>
  </nav>
</BaseLayout>
