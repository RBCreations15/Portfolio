---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import { withBase } from '../lib/paths';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Work" description="Editorial project index for Reese Avery, featuring case-study placeholders and an evolving creative archive.">
  <header class="site-container pb-16 pt-16 lg:pb-24 lg:pt-24">
    <div class="grid gap-8 md:grid-cols-12 md:items-end">
      <div class="md:col-span-8">
        <p class="eyebrow mb-6 text-clay">Work · 01—03</p>
        <h1 class="page-title">An index of worlds in progress.</h1>
      </div>
      <p class="body-large m-0 text-muted md:col-span-4">Creative direction, brand strategy, content, photography, and visual studies. No outcomes or project claims are added until approved.</p>
    </div>
  </header>

  <section class="site-container pb-[var(--section-space)]" aria-labelledby="project-index-heading">
    <h2 id="project-index-heading" class="sr-only">Project index</h2>
    <div class="grid gap-10">
      {projects.map((project, index) => (
        <article class="grid gap-6 border-t border-line py-8 md:grid-cols-12 md:items-center">
          <p class="eyebrow m-0 text-clay md:col-span-1">{String(index + 1).padStart(2, '0')}</p>
          <a href={withBase(`/projects/${project.id}/`)} class="no-underline md:col-span-4">
            <h2 class="m-0 font-title text-[clamp(2.6rem,6vw,6rem)] font-black uppercase leading-[0.86]">{project.data.title}</h2>
          </a>
          <div class="md:col-span-4">
            <p class="eyebrow mb-3 text-muted">{project.data.categories.join(' · ')}</p>
            <p class="m-0 text-muted">{project.data.summary}</p>
            <p class="eyebrow mt-5 text-clay">{project.data.status.replace('-', ' ')}</p>
          </div>
          <a href={withBase(`/projects/${project.id}/`)} class="block no-underline md:col-span-3" aria-label={`Open ${project.data.title}`}>
            <ImagePlaceholder label={`${project.data.title} index image`} alt={`Placeholder for ${project.data.title} index image`} orientation={index === 1 ? 'landscape' : 'portrait'} tone={index === 0 ? 'clay' : index === 1 ? 'olive' : 'tobacco'} />
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
