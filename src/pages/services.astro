---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCta from '../components/ContactCta.astro';
import ServiceBlock from '../components/ServiceBlock.astro';
import { services } from '../data/services';
---

<BaseLayout title="Services" description="Creative direction, brand strategy, identity, photography, content, websites, campaigns, styling, and experience services.">
  <header class="site-container pb-20 pt-16 lg:pb-32 lg:pt-24">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-9">
        <p class="eyebrow mb-6 text-clay">Services · 01—05</p>
        <h1 class="page-title max-w-[14ch]">Support for the world around the work.</h1>
      </div>
      <div class="md:col-span-4 md:col-start-9 md:self-end">
        <p class="body-large m-0 text-muted">Clear, honest creative support across direction, strategy, imagery, content, digital presentation, styling, and experiential detail.</p>
      </div>
    </div>
  </header>

  <section class="site-container pb-[var(--section-space)]" aria-label="Service details">
    {services.map((service) => (
      <div id={`service-${service.number}`} class="scroll-mt-8">
        <ServiceBlock service={service} />
      </div>
    ))}
  </section>

  <section class="bg-paper-deep">
    <div class="site-container section-space grid gap-10 md:grid-cols-12">
      <div class="md:col-span-3">
        <p class="eyebrow m-0 text-clay">Scope note</p>
      </div>
      <div class="md:col-span-8 md:col-start-5">
        <h2 class="m-0 font-display text-[clamp(3rem,6vw,6rem)] font-normal leading-[0.95] tracking-[-0.04em]">
          Built around the actual need.
        </h2>
        <p class="body-large mt-8 text-muted">Services can be shaped into a focused project once the context, timeline, and creative goals are clear.</p>
        <p class="mt-6 max-w-2xl text-muted">This site does not imply complex engineering, paid advertising management, architecture, or services outside the list above.</p>
      </div>
    </div>
  </section>

  <ContactCta />
</BaseLayout>
