---
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
import { siteData } from '../data/site';

const mailto = 'mailto:?subject=Project%20Inquiry%20for%20Reese%20Avery';
---

<BaseLayout title="Contact" description="Contact Reese Avery for collaborations, creative projects, brand work, photography, and thoughtful ideas.">
  <header class="site-container pb-16 pt-16 lg:pb-24 lg:pt-24">
    <div class="grid gap-10 md:grid-cols-12 md:items-end">
      <div class="md:col-span-8">
        <p class="eyebrow mb-6 text-clay">Contact</p>
        <h1 class="page-title max-w-[14ch]">Let’s build something people remember.</h1>
      </div>
      <div class="md:col-span-4">
        <p class="body-large m-0 text-muted">For collaborations, creative projects, brand work, photography, and thoughtful ideas.</p>
      </div>
    </div>
  </header>

  <section class="site-container pb-[var(--section-space)]">
    <div class="grid gap-16 md:grid-cols-12 lg:gap-20">
      <aside class="md:col-span-4">
        <div class="border-t border-line pt-5 md:sticky md:top-8">
          <h2 class="eyebrow mb-6">Direct contact</h2>
          <dl class="m-0 space-y-6 text-sm">
            <div><dt class="eyebrow mb-2 text-muted">Email</dt><dd class="m-0"><a href={mailto}>{siteData.email}</a></dd></div>
            <div><dt class="eyebrow mb-2 text-muted">Instagram</dt><dd class="m-0">{siteData.instagram}</dd></div>
            <div><dt class="eyebrow mb-2 text-muted">Location / availability</dt><dd class="m-0 text-muted">{siteData.location} · {siteData.availability}</dd></div>
          </dl>
        </div>
      </aside>

      <div class="md:col-span-7 md:col-start-6">
        <div class="border-y border-line py-6">
          <p class="eyebrow mb-6 text-clay">Inquiry outline</p>
          <p class="m-0 text-muted">A direct email address is pending approval. Once added, a concise note with the details below will be the clearest way to begin.</p>
          <ul class="mt-8 grid list-none gap-4 p-0 sm:grid-cols-2">
            {['Your name and brand', 'What you are building', 'Services you are considering', 'Timeline or launch date', 'Location, if relevant', 'Links, references, or notes'].map((item) => (
              <li class="border-t border-line pt-3 text-sm">{item}</li>
            ))}
          </ul>
          <div class="mt-10">
            <ButtonLink href={mailto}>Email inquiry</ButtonLink>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
