---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
import { siteData } from '../data/site';
---

<BaseLayout title="Contact" description="Start a creative project inquiry. The static form interface is ready to connect to an approved form service.">
  <header class="site-container pb-16 pt-16 lg:pb-24 lg:pt-24">
    <div class="grid gap-10 md:grid-cols-12 md:items-end">
      <div class="md:col-span-8">
        <p class="eyebrow mb-6 text-clay">Inquiries</p>
        <h1 class="page-title max-w-[14ch]">Bring the idea. Let’s find its shape.</h1>
      </div>
      <div class="md:col-span-4">
        <p class="body-large m-0 placeholder-copy">[Placeholder — add an approved invitation describing the kinds of conversations and collaborations you welcome.]</p>
      </div>
    </div>
  </header>

  <section class="site-container pb-[var(--section-space)]">
    <div class="grid gap-16 md:grid-cols-12 lg:gap-20">
      <aside class="md:col-span-4">
        <div class="border-t border-line pt-5 md:sticky md:top-8">
          <h2 class="eyebrow mb-6">Direct contact</h2>
          <dl class="m-0 space-y-6 text-sm">
            <div><dt class="eyebrow mb-2 text-muted">Email</dt><dd class="m-0">{siteData.email}</dd></div>
            <div><dt class="eyebrow mb-2 text-muted">Instagram</dt><dd class="m-0">{siteData.instagram}</dd></div>
            <div><dt class="eyebrow mb-2 text-muted">Availability</dt><dd class="m-0 placeholder-copy">{siteData.availability}</dd></div>
          </dl>
          <div class="mt-12 border-t border-line pt-5">
            <h2 class="eyebrow mb-4">Project fit</h2>
            <p class="m-0 text-sm placeholder-copy">[Placeholder — explain the project types, creative alignment, scope, and working relationships you are open to.]</p>
          </div>
        </div>
      </aside>

      <div class="md:col-span-7 md:col-start-6">
        <div class="mb-8 border-y border-clay bg-clay/5 p-4 text-sm" id="form-notice">
          <strong>Form preview:</strong> this interface is not connected to an endpoint yet. No submission will be sent or stored. See the README for safe connection options.
        </div>
        <form id="inquiry-form" aria-describedby="form-notice form-status" novalidate>
          <div class="grid gap-x-6 gap-y-8 sm:grid-cols-2">
            <div class="field">
              <label for="name">Name <span aria-hidden="true">*</span></label>
              <input id="name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="email">Email <span aria-hidden="true">*</span></label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="field sm:col-span-2">
              <label for="business">Business or brand</label>
              <input id="business" name="business" type="text" autocomplete="organization" />
            </div>
            <div class="field">
              <label for="service">Service of interest</label>
              <select id="service" name="service">
                <option value="">Select a service</option>
                {services.map((service) => <option value={service.title}>{service.title}</option>)}
                <option value="custom">Custom combination / not sure yet</option>
              </select>
            </div>
            <div class="field">
              <label for="budget">Estimated budget</label>
              <select id="budget" name="budget">
                <option value="">Select or discuss later</option>
                <option value="pending">[Budget ranges pending]</option>
              </select>
            </div>
            <div class="field sm:col-span-2">
              <label for="timeline">Desired timeline</label>
              <input id="timeline" name="timeline" type="text" placeholder="[Share a date or general timing]" />
            </div>
            <div class="field sm:col-span-2">
              <label for="description">Project description <span aria-hidden="true">*</span></label>
              <textarea id="description" name="description" rows="7" required placeholder="Tell me what you’re making, where you are in the process, and what kind of support you’re looking for."></textarea>
            </div>
          </div>
          <button type="submit" class="mt-8 min-h-12 border border-ink bg-ink px-7 py-3 text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-paper transition-colors hover:border-clay hover:bg-clay">
            Review inquiry
          </button>
          <p id="form-status" class="mt-5 min-h-6 text-sm text-clay" role="status" aria-live="polite" tabindex="-1"></p>
        </form>
      </div>
    </div>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>('#inquiry-form');
    const status = document.querySelector<HTMLElement>('#form-status');

    form?.addEventListener('submit', (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        if (status) status.textContent = 'Please complete the required fields before reviewing your inquiry.';
        return;
      }

      if (status) {
        status.textContent = 'Your details look ready. This preview does not send or store them until an approved static-form service is connected.';
        status.focus();
      }
    });
  </script>
</BaseLayout>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .field label {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 3.25rem;
    border: 0;
    border-bottom: 1px solid var(--color-line);
    border-radius: 0;
    padding: 0.75rem 0;
    color: var(--color-ink);
    background: transparent;
  }

  .field textarea {
    resize: vertical;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    border-color: var(--color-clay);
    outline: 0;
    box-shadow: 0 2px 0 var(--color-clay);
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--color-muted);
    opacity: 0.8;
  }
</style>
