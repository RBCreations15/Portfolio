---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
import ContactCta from '../components/ContactCta.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { coreServices } from '../data/services';
import { homeCopy, siteData } from '../data/site';
import { withBase } from '../lib/paths';

const featuredProjects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const archiveEntries = (await getCollection('archive')).sort((a, b) => a.data.order - b.data.order).slice(0, 6);
---

<BaseLayout>
  <section class="site-container grid min-h-[calc(100svh-5rem)] grid-rows-[1fr_auto] py-8 lg:min-h-[calc(100svh-6rem)] lg:py-10">
    <div class="grid items-center gap-10 py-10 lg:grid-cols-12 lg:py-14">
      <div class="relative z-10 lg:col-span-8">
        <p class="eyebrow mb-7 text-clay">{homeCopy.descriptor}</p>
        <h1 class="display-title">{siteData.name}</h1>
        <p class="body-large mt-7 max-w-2xl">{homeCopy.supporting}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <ButtonLink href={withBase('/work/')}>View Work</ButtonLink>
          <ButtonLink href={withBase('/contact/')} variant="outline">Get in Touch</ButtonLink>
        </div>
      </div>
      <div class="editorial-panel lg:col-span-4 lg:self-stretch">
        <ImagePlaceholder label="Editorial art direction panel" alt="Decorative editorial placeholder establishing the portfolio visual tone" orientation="portrait" tone="olive" eager />
      </div>
    </div>
    <div class="grid grid-cols-2 gap-4 border-t border-line pt-4 text-[0.62rem] uppercase tracking-[0.13em] text-muted sm:grid-cols-3">
      <p class="m-0">Independent creative practice</p>
      <p class="m-0 sm:text-center">{siteData.location}</p>
      <p class="m-0 hidden text-right sm:block">Visual archive · 2026</p>
    </div>
  </section>

  <section class="site-container section-space">
    <SectionHeader
      eyebrow="Selected Work"
      title="Brand worlds, campaigns, images, and studies."
      description="Project pages are intentionally structured now and ready for approved imagery, context, roles, and credits."
    />
    <div class="mt-16 space-y-20 lg:mt-24 lg:space-y-28">
      {featuredProjects.map((project, index) => <ProjectCard project={project} index={index} large />)}
    </div>
  </section>

  <section class="bg-ink text-paper">
    <div class="site-container section-space grid gap-12 md:grid-cols-12">
      <div class="md:col-span-4">
        <p class="eyebrow mb-6 text-paper/55">About Preview</p>
        <h2 class="m-0 font-display text-[clamp(3rem,6vw,6rem)] font-normal leading-[0.96] tracking-[-0.04em]">
          Felt before it is explained.
        </h2>
      </div>
      <div class="md:col-span-7 md:col-start-6">
        <div class="space-y-5 text-lg leading-relaxed text-paper/75">
          {homeCopy.aboutPreview.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <a class="text-link mt-8" href={withBase('/about/')}>Read About</a>
      </div>
    </div>
  </section>

  <section class="site-container section-space">
    <SectionHeader eyebrow="Services Preview" title="A practical index for making atmosphere." />
    <ol class="mt-14 grid list-none border-t border-line p-0 md:grid-cols-2 lg:grid-cols-7">
      {coreServices.map((service, index) => (
        <li class="min-h-40 border-b border-line p-5 md:border-r">
          <span class="eyebrow text-clay">{String(index + 1).padStart(2, '0')}</span>
          <p class="mt-12 font-display text-2xl leading-none">{service}</p>
        </li>
      ))}
    </ol>
    <a class="text-link mt-8" href={withBase('/services/')}>View Services</a>
  </section>

  <section class="bg-paper-deep">
    <div class="site-container section-space">
      <SectionHeader eyebrow="Archive Preview" title="Studies, notes, materials, places." />
      <div class="mt-14 grid gap-5 md:grid-cols-3">
        {archiveEntries.map((entry, index) => (
          <a href={withBase(`/archive/${entry.id}/`)} class="group border-t border-line py-5 no-underline" aria-label={`Open archive entry: ${entry.data.title}`}>
            <p class="eyebrow mb-3 text-muted">{String(index + 1).padStart(2, '0')} · {entry.data.category}</p>
            <h3 class="m-0 font-display text-3xl font-normal leading-none">{entry.data.title}</h3>
            <p class="mt-4 text-sm text-muted">{entry.data.summary}</p>
          </a>
        ))}
      </div>
      <a class="text-link mt-10" href={withBase('/archive/')}>Open Archive</a>
    </div>
  </section>

  <ContactCta />
</BaseLayout>
