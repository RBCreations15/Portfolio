---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCta from '../components/ContactCta.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import { aboutCopy, siteData } from '../data/site';
---

<BaseLayout title="About" description="About Reese Avery, a multidisciplinary creative focused on creative direction, brand worlds, and visual storytelling.">
  <header class="site-container pb-16 pt-16 lg:pb-24 lg:pt-24">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-9">
        <p class="eyebrow mb-6 text-clay">About · {siteData.name}</p>
        <h1 class="page-title max-w-[15ch]">{aboutCopy.opening}</h1>
      </div>
      <p class="body-large m-0 text-muted md:col-span-4 md:col-start-9 md:self-end">{siteData.title}</p>
    </div>
  </header>

  <section class="site-container pb-[var(--section-space)]">
    <div class="grid gap-12 md:grid-cols-12 md:items-start">
      <div class="reveal md:col-span-6">
        <ImagePlaceholder label="Approved portrait pending" alt="Placeholder for an approved portrait of Reese Avery" orientation="portrait" tone="rose" eager />
      </div>
      <div class="reveal md:col-span-5 md:col-start-8">
        <p class="eyebrow mb-5 text-clay">Biography</p>
        <div class="space-y-5 text-lg leading-relaxed text-muted">
          {aboutCopy.biography.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <dl class="mt-10 border-t border-line pt-5 text-sm">
          <div class="grid grid-cols-2 gap-4 border-b border-line py-3">
            <dt class="eyebrow">Location</dt><dd class="m-0 text-right text-muted">{siteData.location}</dd>
          </div>
          <div class="grid grid-cols-2 gap-4 border-b border-line py-3">
            <dt class="eyebrow">Availability</dt><dd class="m-0 text-right text-muted">{siteData.availability}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="border-y border-line">
    <div class="site-container section-space grid gap-12 lg:grid-cols-3">
      <div>
        <p class="eyebrow mb-8 text-clay">Selected disciplines</p>
        <ul class="m-0 list-none p-0">
          {aboutCopy.disciplines.map((item) => <li class="border-t border-line py-4 font-display text-2xl">{item}</li>)}
        </ul>
      </div>
      <div>
        <p class="eyebrow mb-8 text-clay">Creative values</p>
        <ol class="m-0 list-none p-0">
          {aboutCopy.values.map((value, index) => (
            <li class="grid grid-cols-[2rem_1fr] gap-4 border-t border-line py-4">
              <span class="eyebrow text-clay">{String(index + 1).padStart(2, '0')}</span>
              <span class="font-display text-2xl">{value}</span>
            </li>
          ))}
        </ol>
      </div>
      <div>
        <p class="eyebrow mb-8 text-clay">Current tools</p>
        <p class="m-0 border-t border-line pt-4 text-muted">{aboutCopy.tools}</p>
      </div>
    </div>
  </section>

  <ContactCta />
</BaseLayout>
